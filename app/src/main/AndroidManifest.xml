<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ch.atelier.tv" android:versionCode="43" android:versionName="0.17.3">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIRELESS_DEBUGGING_SETTINGS" /></intent>
        <intent><action android:name="android.settings.APPLICATION_DEVELOPMENT_SETTINGS" /></intent>
        <package android:name="com.google.android.tvlauncher" />
    </queries>
    <application android:label="Atelier TV" android:theme="@style/AtelierTheme"
        android:icon="@drawable/icon" android:banner="@drawable/banner"
        android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="landscape" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".GalleryActivity" android:exported="false" android:screenOrientation="landscape" />
        <service android:name=".ArtDreamService" android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE" android:label="Atelier · Galerie d’art">
            <intent-filter><action android:name="android.service.dreams.DreamService" /></intent-filter>
        </service>
        <service android:name=".MusicAccessService" android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:label="Atelier TV · Carte Spotify">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
    </application>
</manifest>
